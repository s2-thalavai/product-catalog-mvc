meta {
  name: Product as HTML
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/products/1
  body: none
  auth: none
}

headers {
  Accept: text/html
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("text/html", () => expect(res.getHeader("content-type")).to.contain("text/html"));
  test("HTML document", () => expect(res.getBody()).to.contain("<!DOCTYPE html>"));
  test("strict CSP", () => expect(res.getHeader("content-security-policy")).to.contain("default-src 'none'"));
}
