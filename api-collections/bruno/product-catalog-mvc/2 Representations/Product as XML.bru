meta {
  name: Product as XML
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/products/1
  body: none
  auth: none
}

headers {
  Accept: application/xml
}

tests {
  const tag = (n) => (String(res.getBody()).match(new RegExp('<' + n + '>([^<]*)</' + n + '>')) || [])[1];
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("application/xml", () => expect(res.getHeader("content-type")).to.contain("application/xml"));
  test("<product> root with id 1", () => expect(tag("id")).to.equal("1"));
}
