# Copy to .env (git-ignored) and fill in.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-please
# Your fork/push of this project. Private repo? Add a "git-creds" credential in Jenkins
# and reference it in casc.yaml (remote { url(...); credentials('git-creds') }).
GIT_REPO_URL=https://github.com/<your-user>/product-catalog-mvc.git
GIT_BRANCH=main
